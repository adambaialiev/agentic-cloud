{
  "name": "infinite-agents-backend",
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "rm -rf dist && tsc -b && cp ../cli/agentbuilt/agentbuilt.mjs dist/agentbuilt-cli.mjs && cp src/ops-miniapp.html dist/ops-miniapp.html && cp ../infra/ci-runner/runner-agent.sh dist/ci-runner-agent.sh && npm run build:workspace-ui",
    "build:workspace-ui": "tsc -p workspace-ui && vite build --config workspace-ui/vite.config.ts",
    "dev:workspace-ui": "vite build --watch --config workspace-ui/vite.config.ts",
    "start": "node dist/index.js",
    "test:core": "vitest run",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage:core": "vitest run --coverage && npm run check:central-coverage",
    "test:coverage": "vitest run --coverage && npm run check:central-coverage",
    "check:central-coverage": "node scripts/check-central-coverage.mjs",
    "read-agent-conversation": "node scripts/read-agent-conversation.mjs",
    "cli:versions": "node scripts/harness-cli-versions.mjs",
    "user:delete": "node scripts/delete-user-profile.mjs",
    "usage:report": "node scripts/machine-usage-report.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.91",
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "ai": "^6.0.67",
    "better-sqlite3": "^13.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.0",
    "mpg123-decoder": "^1.0.3",
    "nodemailer": "10.0.16",
    "openai": "^6.42.0",
    "postal-mime": "^3.0.0",
    "qrcode": "^1.5.4",
    "ssh2": "^1.17.0",
    "undici": "^7.25.0",
    "wasm-media-encoders": "^0.7.0",
    "ws": "^8.18.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.0.18",
    "jsdom": "^27.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.6",
    "vitest": "^4.0.18"
  }
}
