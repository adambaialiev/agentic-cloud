# Backend Environment Variables
# Copy this file to .env and fill in the values

# Server Configuration
PORT=3001
CORS_ORIGIN=http://localhost:5175
# Production: CORS_ORIGIN=https://agenticcloudcomputer.com
WEB_APP_BASE_URL=http://localhost:5175
# Production: WEB_APP_BASE_URL=https://agenticcloudcomputer.com
# Public backend origin written into managed agents' CLI configuration.
# Production: AGENTBUILT_API_URL=https://api.agenticcloudcomputer.com
AGENTBUILT_API_URL=http://localhost:3001

# Self-hosted machine connect command URLs
# SELF_HOSTED_PUBLIC_API_URL defaults to a placeholder when unset.
SELF_HOSTED_PUBLIC_API_URL=http://localhost:3001
# SELF_HOSTED_PUBLIC_APP_URL defaults through FRONTEND_URL, PUBLIC_URL, WEB_APP_BASE_URL, then CORS_ORIGIN.
SELF_HOSTED_PUBLIC_APP_URL=http://localhost:5175
# SELF_HOSTED_CONNECT_SCRIPT_URL=http://localhost:5175/connect-self-hosted.sh
SELF_HOSTED_RELAY_ENABLED=true

# AI Model Configuration
AI_MODEL=minimax/minimax-m3
MINIMAX_API_KEY=your_minimax_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# Enables DeepSeek 2x peak-window pricing from this UTC timestamp onward.
# Peak windows are 01:00-04:00 UTC and 06:00-10:00 UTC.
# Leave unset until the provider confirms the exact effective date/time.
# DEEPSEEK_PEAK_PRICING_EFFECTIVE_AT=2026-07-15T00:00:00.000Z
OPENROUTER_API_KEY=your_openrouter_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Voice transcription
# Default is OpenRouter STT with Whisper Large V3 Turbo. Set provider=openai to roll back to
# OpenAI audio.transcriptions models such as gpt-4o-transcribe or whisper-1.
VOICE_TRANSCRIPTION_PROVIDER=openrouter
VOICE_TRANSCRIPTION_MODEL=openai/whisper-large-v3-turbo
OPENAI_API_KEY=your_openai_api_key_here

# Spotify playlist tool
# Uses one bot-owned Spotify account. Users do not need Spotify accounts.
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token_here

# DigitalOcean sandbox / droplet infrastructure
DIGITALOCEAN_TOKEN=your_digitalocean_api_token_here
DIGITALOCEAN_SSH_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----"
DIGITALOCEAN_SSH_PUBLIC_KEY=ssh-ed25519 AAAA... your-key-comment
DIGITALOCEAN_SSH_PASSPHRASE=
DIGITALOCEAN_SSH_USERNAME=root
DIGITALOCEAN_SSH_PORT=22
DIGITALOCEAN_SANDBOX_REGION=fra1
DIGITALOCEAN_SANDBOX_SIZE=s-2vcpu-2gb-intel
DIGITALOCEAN_SANDBOX_IMAGE=ubuntu-24-04-x64
DIGITALOCEAN_SANDBOX_SSH_KEY_NAME=default-development-droplet

# Hetzner Cloud sandbox / server infrastructure
# Hetzner is the default provider for development sandboxes.
# Generic create-server/list-server-sizes/upgrade-server/delete-server also accept provider=hetzner.
MANAGED_SERVER_PROVIDER=hetzner
HETZNER_API_TOKEN=your_hetzner_api_token_here
HETZNER_SSH_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----"
HETZNER_SSH_PUBLIC_KEY=ssh-ed25519 AAAA... your-key-comment
HETZNER_SSH_PASSPHRASE=
HETZNER_SSH_USERNAME=root
HETZNER_SSH_PORT=22
HETZNER_SANDBOX_LOCATION=nbg1
HETZNER_SANDBOX_SERVER_TYPE=cpx22
HETZNER_SANDBOX_IMAGE=ubuntu-24.04
HETZNER_SANDBOX_SSH_KEY_NAME=default-development-server

# EUR/USD rate cache for Hetzner EUR billing conversion. Default: 3600000 (1 hour).
FX_RATE_CACHE_TTL_MS=3600000

# Optional internal operations bot. This is not a customer login or messaging channel.
TELEGRAM_OPS_BOT_TOKEN=
TELEGRAM_OPS_CHAT_ID=
TELEGRAM_OPS_WEBHOOK_URL=
TELEGRAM_OPS_WEBHOOK_SECRET=

# Internal broadcaster allowlist used by operator tools.
TELEGRAM_BROADCASTER_USER_IDS=

# Note: For Cloudflare Workers deployment, use the separate variables
# as defined in backend/wrangler.toml secrets section

# S3-compatible media storage (attachments are disabled unless all four are set)
# MEDIA_S3_ENDPOINT=https://your-minio-host.example.com
# MEDIA_S3_BUCKET=ia-media
# MEDIA_S3_ACCESS_KEY_ID=...
# MEDIA_S3_SECRET_ACCESS_KEY=...
# MEDIA_S3_REGION=us-east-1
# MEDIA_S3_FORCE_PATH_STYLE=true

# Persistence: SQLite file on the backend host. Without it the backend runs
# on in-memory storage, which does not survive a restart.
# SQLITE_DB_PATH=/var/lib/infinite-agents/backend.db
