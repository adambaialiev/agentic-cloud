#!/usr/bin/env node
/**
 * Tells a CI daemon that refs moved, so pushes to our own git host can drive
 * builds the way GitHub webhooks do. Installed into every bare repo by
 * git-host.mjs alongside pre-receive.
 *
 * Silent unless the repo opts in. `agentgit.webhookUrl` is unset on every
 * ordinary agent repo, and this exits immediately in that case — the common
 * path costs one `git config` read.
 *
 * Deliberately configured through the repo's own git config rather than
 * through the control API:
 *
 *   git --git-dir <repo>.git config agentgit.webhookUrl http://10.0.0.5:8787/webhook
 *   git --git-dir <repo>.git config agentgit.webhookSecret <shared secret>
 *
 * A user-supplied webhook URL would turn this host into an SSRF proxy — it
 * sits inside the private network and would happily POST wherever it was
 * pointed. So the URL is set by whoever has a shell on the box, never by an
 * API caller. Same reasoning as agentgit.protectedBranch living here: config
 * in the repo survives restarts, moves and restores.
 *
 * post-receive runs while the pusher waits, and its exit status cannot fail a
 * push that has already landed. So this never throws, never retries, and gives
 * the receiver a hard 5 seconds before giving up: a CI daemon that is down must
 * cost a missed build, never a hung `git push`.
 */

import { execFileSync } from 'node:child_process';
import { createHmac } from 'node:crypto';
import { readFileSync } from 'node:fs';
import path from 'node:path';

const TIMEOUT_MS = 5000;
const ZERO_SHA = /^0+$/;

// Off-boarded host: the dispatcher this hook would notify left with the
// platform, and a dead webhook would cost every push its 5-second timeout.
if (process.env.AGENTGIT_STANDALONE) process.exit(0);

function config(key) {
  try {
    return execFileSync('git', ['config', '--get', key], { encoding: 'utf8' }).trim() || null;
  } catch {
    // Exit status 1 simply means "not set", which is the usual case.
    return null;
  }
}

function subjectOf(sha) {
  try {
    return execFileSync('git', ['log', '-1', '--format=%s', sha], { encoding: 'utf8' }).trim();
  } catch {
    return '';
  }
}

async function main() {
  const url = config('agentgit.webhookUrl');
  if (!url) return;

  const secret = config('agentgit.webhookSecret');
  if (!secret) {
    // Refusing to send unsigned is the safe failure: a receiver that trusts
    // unsigned pushes would take builds from anyone who can reach the port.
    process.stderr.write('remote: agentgit.webhookUrl is set but agentgit.webhookSecret is not — not sending\n');
    return;
  }

  // GIT_DIR is the bare repo; its name and its parent name are the repo and
  // the owning user, matching /var/lib/agentgit/repos/<userId>/<name>.git.
  const gitDir = path.resolve(process.env.GIT_DIR || '.');
  const name = path.basename(gitDir).replace(/\.git$/, '');
  const owner = path.basename(path.dirname(gitDir));

  const updates = readFileSync(0, 'utf8')
    .split('\n')
    .map((line) => line.trim())
    .filter(Boolean)
    .map((line) => line.split(/\s+/))
    .filter(([, , ref]) => Boolean(ref));

  for (const [before, after, ref] of updates) {
    const deleted = ZERO_SHA.test(after);
    const body = JSON.stringify({
      ref,
      before,
      after,
      deleted,
      repository: { name, owner, full_name: `${owner}/${name}` },
      // The receiver only needs ref + after; the subject is here so a CI log
      // says which commit it is building rather than only a hash.
      head_commit: deleted ? null : { id: after, message: subjectOf(after) },
    });

    try {
      const response = await fetch(url, {
        method: 'POST',
        headers: {
          'content-type': 'application/json',
          'user-agent': 'agentgit-post-receive',
          'x-agentgit-event': 'push',
          'x-agentgit-signature-256': 'sha256=' + createHmac('sha256', secret).update(body).digest('hex'),
        },
        body,
        signal: AbortSignal.timeout(TIMEOUT_MS),
      });
      if (!response.ok) {
        // Shown to whoever pushed: a build that never starts is otherwise
        // indistinguishable from one that started and is slow.
        process.stderr.write(`remote: CI webhook returned ${response.status} for ${ref}\n`);
      }
    } catch (error) {
      process.stderr.write(`remote: CI webhook unreachable (${error.name}) — push landed, build not triggered\n`);
    }
  }
}

main().catch(() => {
  // Never let a notification failure look like a failed push.
  process.exit(0);
});
