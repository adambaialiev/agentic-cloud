# ============================================================================
# Infinite Agents backend — environment file
# Installed by provision.sh to /etc/infinite-agents/backend.env (mode 600, root)
# ============================================================================
#
# THIS IS A PLACEHOLDER. Every value is a dummy. The backend starts with these
# but exits/degrades because the secrets are fake — that is intentional until
# cutover. At cutover, copy the REAL values from the Render dashboard
# (Service: infinite-agents, Environment tab) into this file. See
# docs/backend-cutover-runbook.md.
#
# The backend does NOT hard-crash on most missing vars (config warns and
# disables the relevant feature), but several are load-bearing in production.
# Required-at-cutover vars are marked [REQUIRED].
# ----------------------------------------------------------------------------

# ── Server ──
PORT=3001
# Public origins allowed by CORS and used to build links.
CORS_ORIGIN=https://agenticcloudcomputer.com
WEB_APP_BASE_URL=https://agenticcloudcomputer.com
FRONTEND_URL=https://agenticcloudcomputer.com
# PUBLIC_URL / SELF_HOSTED_PUBLIC_APP_URL fall back through the above if unset.
SELF_HOSTED_PUBLIC_APP_URL=https://agenticcloudcomputer.com
# Canonical regular-browser Workspace. This exact origin is also the trust
# anchor for login and cookie-authenticated mutation Origin checks.
WORKSPACE_URL=https://agenticcloudcomputer.com/workspace
# Old direct links and already-open api-host sessions remain valid while the
# main-domain door becomes canonical. Comma-separated, explicit origins only.
WORKSPACE_COMPATIBLE_ORIGINS=https://api.agenticcloudcomputer.com
# A sending-only Resend key for ownership confirmation. Existing accounts can
# still sign in without it, but new registration fails closed. Verify the
# sender's domain with SPF/DKIM before enabling this in production.
RESEND_API_KEY=
WORKSPACE_EMAIL_FROM="Agentic Cloud Computer <workspace@updates.agenticcloudcomputer.com>"
# Public backend origin written into every agent machine's CLI config. This is
# independent of the browser Workspace origin and must never be inferred from
# a retired Telegram webhook setting.
AGENTBUILT_API_URL=https://api.agenticcloudcomputer.com

# ── Inbound mail (note #509 slice 2) ──
# The shared secret Cloudflare's `mail-inbound` Email Worker presents on every
# ingest call (infra/mail-inbound/README.md). The SAME value must be set as a
# Worker secret; the backend accepts exactly one. Without it — or without the
# MEDIA_S3_* store the raw messages go to — the ingest routes 503, the Worker
# fails the delivery and sending servers retry rather than bouncing.
# Generate with `openssl rand -hex 32`.
MAIL_INGEST_SECRET=
# Replying from a person's own address (note #509 slice 4). A DIFFERENT Resend
# key from RESEND_API_KEY above: that one is scoped to
# updates.agenticcloudcomputer.com and carries the sign-in links' reputation,
# while this one sends as the person from the ROOT domain (whose DKIM record
# and `send.` Return-Path subdomain are already in the zone). Without it the
# reply route 503s and the inbox screen offers no Reply at all.
RESEND_MAIL_API_KEY=

# Browser (Web Push) notifications were retired by note #477; the former
# WEB_PUSH_VAPID_* keys are no longer read.

# ── Internal ops bot (optional; not a customer channel) ──
TELEGRAM_OPS_BOT_TOKEN=
TELEGRAM_OPS_CHAT_ID=
TELEGRAM_OPS_WEBHOOK_URL=
TELEGRAM_OPS_WEBHOOK_SECRET=

# ── Persistence [REQUIRED] ──
# SQLite file on this host. Without it the backend falls back to in-memory
# storage and loses everything on restart.
SQLITE_DB_PATH=/var/lib/infinite-agents/backend.db

# Encrypts secret VALUES at rest (AES-256-GCM) so the DB file and its nightly
# S3 backups hold only ciphertext. Generate with `openssl rand -base64 32`.
# LOSING THIS KEY LOSES EVERY STORED SECRET — it must survive host rebuilds
# with the rest of this file. After first setting it, run
# `node backend/scripts/encrypt-secrets.mjs --apply` to convert existing rows.
SECRETS_MASTER_KEY=PLACEHOLDER_openssl_rand_base64_32

# ── AI providers [REQUIRED: at least the ones the active AI_MODEL uses] ──
AI_MODEL=minimax/minimax-m3
MINIMAX_API_KEY=PLACEHOLDER_minimax_key
DEEPSEEK_API_KEY=PLACEHOLDER_deepseek_key
OPENROUTER_API_KEY=PLACEHOLDER_openrouter_key
ANTHROPIC_API_KEY=PLACEHOLDER_anthropic_key
OPENAI_API_KEY=PLACEHOLDER_openai_key

# ── Voice transcription ──
VOICE_TRANSCRIPTION_PROVIDER=openrouter
VOICE_TRANSCRIPTION_MODEL=openai/whisper-large-v3-turbo

# ── Media generation (fal.ai) ──
# Also makes the work radio's tracks (note #712): thirty straight away, 90
# seconds and about 3 cents each, then none (backend/src/services/radio-library.ts).
FAL_KEY=PLACEHOLDER_fal_key
# The work radio is OFF unless WORK_RADIO=on (note #842, 2026-10-30): off, no
# button, no library page, no station and no track making. Its tracks stay in
# the bucket and the database, so turning it on brings back what it had.
# WORK_RADIO=on
# RADIO_LIBRARY=off stops the radio making tracks; the station keeps playing
# the ones it has.
# RADIO_LIBRARY=off

# ── Spotify playlist tool (single bot-owned account) ──
SPOTIFY_CLIENT_ID=PLACEHOLDER_spotify_client_id
SPOTIFY_CLIENT_SECRET=PLACEHOLDER_spotify_client_secret
SPOTIFY_REFRESH_TOKEN=PLACEHOLDER_spotify_refresh_token

# ── Hetzner sandbox provider (legacy managed-server path) ──
# Still referenced by the current sandbox code until FlySandboxClient fully
# replaces it. Copy the live values from Render.
MANAGED_SERVER_PROVIDER=hetzner
HETZNER_API_TOKEN=PLACEHOLDER_hetzner_token
HETZNER_SSH_PRIVATE_KEY=PLACEHOLDER_multiline_openssh_private_key
HETZNER_SSH_PUBLIC_KEY=ssh-ed25519 PLACEHOLDER
HETZNER_SSH_PASSPHRASE=
HETZNER_SSH_USERNAME=root
HETZNER_SANDBOX_LOCATION=nbg1
HETZNER_SANDBOX_SERVER_TYPE=cpx22
HETZNER_SANDBOX_IMAGE=ubuntu-24.04
HETZNER_SANDBOX_SSH_KEY_NAME=default-development-server

# ── Fly.io machine provider (new — introduced in #696) ──
# The growth-phase target. FLY_SSH_PRIVATE_KEY is the WireGuard-side SSH key the
# backend uses to reach user machines over the `fly` 6PN network.
FLY_API_TOKEN=PLACEHOLDER_fly_org_token
FLY_ORG=PLACEHOLDER_fly_org
FLY_ORG_SLUG=PLACEHOLDER_fly_org_slug
FLY_REGION=fra
# Managed by `npm --prefix backend run cli:versions -- bump`, which rebuilds the
# image against the pinned CLI versions, rewrites this line over SSH, and
# restarts the service. Tags look like `cli-<claude>-<codex>`.
FLY_MACHINE_IMAGE=registry.fly.io/ia-machine-images:latest
FLY_SSH_PRIVATE_KEY=PLACEHOLDER_multiline_openssh_private_key
FLY_SSH_PUBLIC_KEY=ssh-ed25519 PLACEHOLDER
FLY_SSH_PASSPHRASE=

# ── Internal broadcast allowlist (comma-separated Telegram numeric IDs) ──
TELEGRAM_BROADCASTER_USER_IDS=
